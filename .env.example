# =====================================================
# Wissenswerkstatt - Konfiguration
# =====================================================
# Kopiere diese Datei nach ".env" und passe die Werte an.

# --- LLM-Konfiguration (OpenAI-kompatibel) ----------------
# Funktioniert mit: OpenAI, Azure OpenAI, Ollama, LM Studio, vLLM, etc.
# Beispiel OpenAI:    https://api.openai.com/v1
# Beispiel Ollama:    http://host.docker.internal:11434/v1
# Beispiel LM Studio: http://host.docker.internal:1234/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
# Optional: max Tokens pro Antwort
LLM_MAX_TOKENS=1500
# Optional: Temperature (0.0 = deterministisch, 1.0 = kreativ)
LLM_TEMPERATURE=0.4

# --- App-Konfiguration ------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
# Optional: gemeinsames Geheimnis, damit nur du die UI benutzen kannst
APP_SECRET=
# Standard-Zeitzone für Datumsangaben (IANA)
APP_TIMEZONE=Europe/Berlin

# --- Watchtower --------------------------------------------
# Intervall, in dem Watchtower nach neuen Images schaut
WATCHTOWER_POLL_INTERVAL=86400
# Watchtower-Logging: true|false
WATCHTOWER_DEBUG=false
